# Expo inlines every EXPO_PUBLIC_* var into the JS bundle, so only put values
# here that are safe to ship in a published app. The WHOOP client secret is not
# one of them — it stays in the server's own .env.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The Express server. A phone running Expo Go cannot reach your Mac's
# "localhost" — use the LAN address Expo prints on start, e.g.
# http://192.168.1.42:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
