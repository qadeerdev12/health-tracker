# Create an app at https://developer-dashboard.whoop.com to get these.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Must match a Redirect URI registered on your WHOOP app exactly.
WHOOP_REDIRECT_URI=http://localhost:3000/auth/whoop/callback

# Space-separated. `offline` is required to get a refresh token back.
WHOOP_SCOPES=offline read:profile read:body_measurement read:cycles read:recovery read:sleep read:workout

# Supabase project settings -> API. The SERVICE ROLE key bypasses RLS and is the
# only thing that can read whoop_tokens. It must never reach the app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Where the OAuth callback sends the user afterwards. Matches `scheme` in
# mobile/app.json so the in-app browser closes back into the app.
APP_REDIRECT_URL=healthtracker://whoop

# Browser origins allowed to call this server. Only the web target needs it.
CORS_ORIGINS=http://localhost:8081,http://localhost:8082

PORT=3000
